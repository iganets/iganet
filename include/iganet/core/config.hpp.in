#pragma once

/// @brief IgANet version.
#define IGANET_VERSION    "@iganet_VERSION@"
/// @brief Major component of the IgANet version.
#define IGANET_MAJOR      @iganet_VERSION_MAJOR@
/// @brief Minor component of the IgANet version.
#define IGANET_MINOR      @iganet_VERSION_MINOR@
/// @brief Patch component of the IgANet version.
#define IGANET_PATCH      @iganet_VERSION_PATCH@

/// @brief Compile with G+Smo enabled.
#cmakedefine IGANET_WITH_GISMO

/// @brief Compile with Matplotlib enabled.
#cmakedefine IGANET_WITH_MATPLOT

/// @brief Compile with OpenMP enabled.
#cmakedefine IGANET_WITH_OPENMP

/// @brief Compile with MPI enabled.
#cmakedefine IGANET_WITH_MPI

/// @brief Compile with CUDA enabled.
#cmakedefine IGANET_WITH_CUDA

/// @brief Compile with HIP enabled.
#cmakedefine IGANET_WITH_HIP

/// @brief Compile with XPU enabled.
#cmakedefine IGANET_WITH_XPU
