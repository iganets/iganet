#pragma once

#include <filesystem>
#include <string_view>
#include <unistd.h>

#if defined(_WIN32)
#include <direct.h>
#include <windows.h>
#else
#include <dlfcn.h>
#include <fstream>
#include <sys/stat.h>
#if defined(__APPLE__)
#include <mach-o/dyld.h>
#endif
#endif

#include <iganet/utils/fqn.hpp>
#include <iganet/utils/getenv.hpp>

namespace iganet {

class jit : protected utils::FullQualifiedName {
public:
  /// @brief Default constructor.
  jit()
      : temp(getTempPath()), libdir(), cmd("@JIT_CXX_COMPILER@"),
        flags("@JIT_CONFIGURED_FLAGS@"),
        installFlags("@JIT_ALTERNATE_FLAGS@"),
        out("@JIT_CXX_OUTPUT_FLAG@") {
    char *env = std::getenv("JIT_CXX_COMPILER");
    if (env != NULL)
      cmd = env;

    env = std::getenv("JIT_CXX_FLAGS");
    if (env != NULL)
      flags = env;
    else
      selectRuntimeFlags();

    env = std::getenv("JIT_CXX_OUTPUT_FLAG");
    if (env != NULL)
      out = env;

    env = std::getenv("JIT_CXX_TEMP");
    if (env != NULL) {
      temp = env;
      makePath(temp);
    }

    libdir = utils::getenv("IGANET_LIBDIR", std::string{});
    if (libdir.empty()) {
      libdir = temp;
    } else {
      makePath(libdir);
      if (fileExists(libdir.c_str()) != 1)
        throw std::runtime_error(
            "IGANET_LIBDIR does not refer to an existing directory: " + libdir);
    }
  }

  /// @brief Compile dynamical library.
  inline std::string compile(const std::string &includes,
                             const std::string &src,
                             const std::string &name) const {

      // Include the IgANet version and public-header fingerprint in the cache
      // key. This prevents an application rebuilt against changed IgANet
      // headers from silently reusing an ABI-incompatible JIT library.
      // JIT_CACHE_KEY can additionally identify downstream/header-only builds.
      std::string cacheKey = "@IGANET_VERSION@ @JIT_CACHE_FINGERPRINT@";
    if (const char *env = std::getenv("JIT_CACHE_KEY"); env != NULL)
      cacheKey.append(" ").append(env);

    // Determine library name and suffix
    std::string hash = std::to_string(
        std::hash<std::string>()(src + cmd + flags + out + cacheKey));
    std::string libname = libdir + "lib" + name + hash;
#if defined(_WIN32)
    libname.append(".dll");
#elif defined(__APPLE__)
    libname.append(".dylib");
#elif defined(unix) || defined(__unix__) || defined(__unix)
    libname.append(".so");
#else
#error ("Unsupported operating system")
#endif

    // Create source file (if required)
    std::ifstream libfile(libname.c_str());
    if (!libfile) {

      // Check if output directory exists
      switch (fileExists(libdir.c_str())) {
      case (0): // does not exist, create
#if defined(_WIN32)
        if (mkdir(libdir.c_str()) != 0)
          throw std::runtime_error(
              "An error occurred while creating the output directory");
#else
        if (mkdir(libdir.c_str(), S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH) == -1)
          throw std::runtime_error(
              "An error occurred while creating the output directory");
#endif
        break;
      case (2): // exists as a file
        throw std::runtime_error("File with the same name exists");
        break;
      }

      // Write source code to file
      std::string srcname = libdir + "lib" + name + hash + ".cxx";
      std::ofstream srcfile(srcname.c_str());

      srcfile << includes << "\n\n"

              << "#ifdef _WIN32\n"
              << "#define EXPORT extern \"C\" __declspec(dllexport)\n"
              << "#else\n"
              << "#define EXPORT extern \"C\"\n"
              << "#endif\n"

              << "\nextern \"C\" {\n"
              << src << "\n}\n";
      srcfile.close();

#ifdef _WIN32
      // double quotes are better than single quotes..
      std::string syscall = "\"\"" + cmd + "\" " + flags + " \"" + srcname +
                            "\" " + +out + "\"" + libname + "\"\"";
#else
      std::string syscall = "\"" + cmd + "\" " + flags + " \"" + srcname +
                            "\" " + out + "\"" + libname + "\"";
#endif
      const int status = std::system(syscall.c_str());

      // The compiler no longer needs its input once it has terminated.
      // Use the non-throwing overload so a compilation error is not masked
      // by a cleanup error.
      std::error_code cleanup_error;
      std::filesystem::remove(srcname, cleanup_error);

      if (status != 0)
        throw std::runtime_error(
            "An error occurred while compiling the source code");

      if (cleanup_error)
        throw std::runtime_error("Unable to remove temporary source file " +
                                 srcname + ": " + cleanup_error.message());
    }

    return libname;
  }

  /// @brief Prints the object as a string.
  inline void
  pretty_print(std::ostream &os = std::cout) const noexcept override {
    os << name() << "(\ncmd = " << cmd << ", flags = " << flags
       << ", output flag = " << out << ", tempdir = " << temp
       << ", libdir = " << libdir << "\n)";
  }

private:
  /// @brief Select install-tree flags for an installed source-built binary.
  inline void selectRuntimeFlags() {
    std::filesystem::path prefix;

    if (const char *root = std::getenv("IGANET_ROOT"); root != NULL) {
      prefix = root;
      if (!isInstallPrefix(prefix))
        throw std::runtime_error(
            "IGANET_ROOT does not refer to an IgANet installation: " +
            prefix.string());
    }

    // An installed header carries marker-based flags directly.
    if (flags.find(installPrefixMarker()) != std::string::npos) {
      if (prefix.empty())
        prefix = headerInstallPrefix();
      replaceInstallPrefix(flags, prefix);
      return;
    }

    // A source-built executable embeds installFlags. Search upward from the
    // executable, covering conventional bin and nested libexec layouts.
    if (prefix.empty() && !installFlags.empty())
      prefix = executableInstallPrefix();

    if (!prefix.empty() && !installFlags.empty()) {
      flags = installFlags;
      replaceInstallPrefix(flags, prefix);
    }
  }

  inline static constexpr std::string_view installPrefixMarker() {
    return "__IGANET_INSTALL_PREFIX__";
  }

  inline static bool isInstallPrefix(const std::filesystem::path &prefix) {
    return std::filesystem::exists(
        prefix / "@IGANET_INSTALL_INCLUDEDIR@" / "iganet.h");
  }

  inline static std::filesystem::path headerInstallPrefix() {
    const std::filesystem::path headerPath(__FILE__);
    if (!headerPath.is_absolute())
      return "@JIT_INSTALL_FALLBACK_PREFIX@";

    auto prefix = headerPath;
    for (std::size_t level = 0; level < @JIT_INSTALL_PREFIX_DEPTH@; ++level)
      prefix = prefix.parent_path();
    return prefix;
  }

  inline static std::filesystem::path executablePath() {
#if defined(_WIN32)
    std::wstring buffer(MAX_PATH, L'\0');
    const DWORD length = GetModuleFileNameW(
        NULL, buffer.data(), static_cast<DWORD>(buffer.size()));
    if (length == 0)
      return {};
    buffer.resize(length);
    return buffer;
#elif defined(__APPLE__)
    uint32_t size = 0;
    (void)_NSGetExecutablePath(NULL, &size);
    std::string buffer(size, '\0');
    if (_NSGetExecutablePath(buffer.data(), &size) != 0)
      return {};
    return std::filesystem::weakly_canonical(buffer.c_str());
#elif defined(__linux__)
    std::error_code error;
    const auto path = std::filesystem::read_symlink("/proc/self/exe", error);
    return error ? std::filesystem::path{} : path;
#else
    return {};
#endif
  }

  inline static std::filesystem::path executableInstallPrefix() {
    auto candidate = executablePath().parent_path();
    for (std::size_t level = 0; level < 6 && !candidate.empty(); ++level) {
      if (isInstallPrefix(candidate))
        return candidate;
      const auto parent = candidate.parent_path();
      if (parent == candidate)
        break;
      candidate = parent;
    }
    return {};
  }

  /// @brief Replace the install-prefix marker in an install-tree JIT command.
  inline static void replaceInstallPrefix(
      std::string &value, const std::filesystem::path &prefix) {
    constexpr std::string_view marker = installPrefixMarker();
    const auto markerPos = value.find(marker);
    if (markerPos == std::string::npos)
      return;

    const std::string replacement = prefix.string();
    std::size_t pos = 0;
    while ((pos = value.find(marker, pos)) != std::string::npos) {
      value.replace(pos, marker.size(), replacement);
      pos += replacement.size();
    }
  }

  /// @brief Returns the native TEMP directory path.
  inline static std::string getTempPath() {
#if defined(_WIN32)
    TCHAR temp[MAXPATH];
    (void)GetTempPath(MAXPATH, // length of the buffer
                      temp);   // buffer for path
    return std::string(temp);
#else
    // Typically, we should consider TMPDIR
    //   http://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap08.html#tag_08_03
    //   https://en.wikipedia.org/wiki/TMPDIR&oldid=728654758
    char *temp = std::getenv("TMPDIR");

    // getenv returns NULL ptr if the variable is unknown
    // (http://en.cppreference.com/w/cpp/utility/program/getenv). If it is an
    // empty string, we should also exclude it.
    if (temp != NULL && temp[0] != '\0') {
      // note: env variable needs no free
      std::string path(temp);
      makePath(path);
      return path;
    }

    // Okey, if first choice did not work, try this:
    temp = std::getenv("TEMP");
    if (temp != NULL && temp[0] != '\0') {
      // note: env variable needs no free
      std::string path(temp);
      makePath(path);
      return path;
    }

    // And as third choice, use just current directory
    // http://man7.org/linux/man-pages/man2/getcwd.2.html
    temp = getcwd(NULL, 0);
    if (NULL == temp)
      throw std::runtime_error("getcwd returned NULL.");

    // The string is allocated using malloc, see the reference above
    std::string path(temp);
    std::free(temp);
    makePath(path);
    return path;
#endif
  }

  /// @brief Sets last character to the native path separator.
  inline static void makePath(std::string &str) {
    if (str.length() == 0)
      str.push_back('.');
    if (str[str.length() - 1] != getNativePathSeparator())
      str.push_back(getNativePathSeparator());
  }

  /// @brief Returns an integer specifying the status if the given directory
  /// path exists.
  inline static int fileExists(const char *path) {
    struct stat info;

    if (stat(path, &info) != 0)
      return 0; // does not exist
    else if (info.st_mode & S_IFDIR)
      return 1; // is directory
    else
      return 2; // is file
  }

  /// @brief  Returns all valid path separators.
  inline static constexpr std::string_view getValidPathSeparators() noexcept {
#if defined _WIN32 || defined __CYGWIN__
    return "\\/";
#else
    return "/";
#endif
  }

  /// @brief Returns the native path separator.
  inline static char getNativePathSeparator() {
    return getValidPathSeparators()[0];
  }

private:
  /// @brief Strings.
  std::string temp, libdir, cmd, flags, installFlags, out;
};

/// @brief Print (as string) a jit object.
std::ostream &operator<<(std::ostream &os, const jit &obj) {
  obj.pretty_print(os);
  return os;
}

} // namespace iganet
