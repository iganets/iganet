@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Torch)

if(@IGANET_WITH_OPENMP@)
  # AppleClang does not advertise Homebrew/MacPorts libomp automatically.
  # Repeat the discovery hints used when IgANet itself was configured so the
  # exported OpenMP target can be reconstructed by consumers.
  if(APPLE AND (CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" OR
                CMAKE_CXX_COMPILER_ID STREQUAL "Clang"))
    find_path(OpenMP_CXX_INCLUDE_DIR
      NAMES omp.h
      PATHS /usr/local /usr/local/opt/libomp /opt /opt/local
            /opt/homebrew/opt/libomp
      PATH_SUFFIXES include)
    find_library(OpenMP_libomp_LIBRARY
      NAMES omp
      PATHS /usr/local /usr/local/opt/libomp /opt /opt/local
            /opt/homebrew/opt/libomp
      PATH_SUFFIXES lib)
  endif()
  find_dependency(OpenMP COMPONENTS CXX)
endif()

if(@IGANET_WITH_MPI@)
  find_dependency(MPI COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/IgANetTargets.cmake")

check_required_components(IgANet)
